# Environment Variables Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control

# API Configuration
VITE_API_URL=https://freightrekapi.vercel.app
DELHIVERY_TOKEN=your_delhivery_api_token_here

# Google Maps API Key
VITE_MAP_API_KEY=your_google_maps_api_key_here

# CAPTCHA Configuration (Choose one)
VITE_CAPTCHA_SITE_KEY=your_recaptcha_site_key_here
VITE_CLOUDFLARE_SITE_KEY=your_cloudflare_turnstile_site_key_here
VITE_CLOUDFLARE_SECRET_KEY=your_cloudflare_secret_key_here

# Environment
VITE_ENV=development

# ===========================================
# SECURITY NOTE - BACKEND ONLY VARIABLES
# ===========================================
# These should NEVER be exposed to frontend
# Keep these in your backend .env file only:
# 
# DELHIVERY_API_TOKEN=your_delhivery_api_token_here
# JWT_SECRET=your_jwt_secret_here
# DATABASE_URL=your_database_connection_string
# ===========================================
