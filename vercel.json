{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://freightrekapi.vercel.app/:path*"
    },
    {
      "source": "/admin/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path((?!assets).*)",
      "destination": "/index.html"
    }
  ]
}
