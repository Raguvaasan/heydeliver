{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/delhivery-api/:path*",
      "destination": "/api/delhivery?path=:path*"
    },
    {
      "source": "/api/settings/:path*",
      "destination": "https://freightrekapi.vercel.app/api/v1/settings/:path*"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "https://freightrekapi.vercel.app/orders/:path*"
    },
    {
      "source": "/api/shipment/:path*",
      "destination": "https://freightrekapi.vercel.app/api/shipment/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://freightrekapi.vercel.app/admin/:path*"
    },
    {
      "source": "/admin/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path((?!assets).*)",
      "destination": "/index.html"
    }
  ]
}
